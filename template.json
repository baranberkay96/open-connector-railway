{
 "name": "Open Connector (Connect Anything)",
 "description": "Auth gateway linking 1,700+ SaaS apps to AI agents via MCP, API and SDK.",
 "category": "AI/ML",
 "tags": [
  "open-connector",
  "openconnector",
  "mcp",
  "mcp-server",
  "ai-agents",
  "oauth",
  "integrations",
  "api-gateway",
  "saas",
  "postgres"
 ],
 "image": "https://cdn.jsdelivr.net/gh/oomol-lab/open-connector@v1.10.0/web/public/favicon.png",
 "upstream": {
  "repo": "oomol-lab/open-connector",
  "version": "v1.10.0",
  "images": {
   "open-connector": "ghcr.io/oomol-lab/open-connector:v1.10.0@sha256:508acc68b237ab75e5afab35a4df2f2a864ab66520b2913623568f6086bab83a (released 2026-11-12, 118 MB compressed amd64)",
   "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863 (= :18)"
  },
  "checked": "2026-11-19"
 },
 "services": {
  "Open Connector": {
   "icon": "https://cdn.jsdelivr.net/gh/oomol-lab/open-connector@v1.10.0/web/public/favicon.png",
   "source": {
    "repo": "baranberkay96/open-connector-railway",
    "rootDirectory": "/services/connector"
   },
   "startCommand": null,
   "preDeployCommand": null,
   "healthcheckPath": "/health",
   "healthcheckTimeout": 900,
   "restartPolicyType": "ALWAYS",
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": true,
   "targetPort": 3000,
   "tcpProxy": null,
   "volume": {
    "mountPath": "/app/data"
   },
   "variables": {
    "OOMOL_CONNECT_ADMIN_TOKEN": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Admin token for the web console, /api and /docs (16+ characters). Paste it into the console's unlock screen.",
     "required": false
    },
    "OOMOL_CONNECT_RUNTIME_TOKEN": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Bootstrap bearer token for /v1 and /mcp callers (16+ characters). Per-agent tokens can be created in the console's Access tab.",
     "required": false
    },
    "OOMOL_CONNECT_ENCRYPTION_KEY": {
     "defaultValue": "${{secret(64, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Encrypts stored credentials and OAuth settings. Keep a copy: if it changes or is lost, stored credentials cannot be read.",
     "required": false
    },
    "OOMOL_CONNECT_ORIGIN": {
     "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Public URL used for OAuth redirect URLs. Change it when you add a custom domain.",
     "required": false
    },
    "OOMOL_CONNECT_DATABASE_URL": {
     "defaultValue": "${{Postgres.DATABASE_URL}}",
     "description": "PostgreSQL over Railway's private network. Leave empty to use SQLite on the volume instead.",
     "required": false
    },
    "OOMOL_CONNECT_DATA_DIR": {
     "defaultValue": "/app/data",
     "description": "Volume path for transit files, upload staging and the SQLite fallback.",
     "required": false
    },
    "PORT": {
     "defaultValue": "3000",
     "description": "Port OpenConnector listens on and Railway health-checks.",
     "required": false
    }
   }
  },
  "Postgres": {
   "icon": "https://devicons.railway.app/i/postgresql.svg",
   "source": {
    "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
   },
   "startCommand": null,
   "preDeployCommand": null,
   "healthcheckPath": null,
   "healthcheckTimeout": null,
   "restartPolicyType": "ON_FAILURE",
   "restartPolicyMaxRetries": 10,
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": false,
   "targetPort": null,
   "tcpProxy": null,
   "volume": {
    "mountPath": "/var/lib/postgresql/data"
   },
   "variables": {
    "PGDATA": {
     "defaultValue": "/var/lib/postgresql/data/pgdata",
     "description": "Location where the database will be initialized",
     "required": false
    },
    "PGHOST": {
     "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Railway Private Domain Name.",
     "required": false
    },
    "PGPORT": {
     "defaultValue": "5432",
     "description": "Port to connect to Postgres.",
     "required": false
    },
    "PGUSER": {
     "defaultValue": "${{ POSTGRES_USER }}",
     "description": "Required variable for Data panel",
     "required": false
    },
    "PGDATABASE": {
     "defaultValue": "${{POSTGRES_DB}}",
     "description": "Required variable for the data panel.",
     "required": false
    },
    "PGPASSWORD": {
     "defaultValue": "${{POSTGRES_PASSWORD}}",
     "description": "Required variable for Data panel",
     "required": false
    },
    "POSTGRES_DB": {
     "defaultValue": "railway",
     "description": "Default database created when image is started.",
     "required": false
    },
    "DATABASE_URL": {
     "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
     "description": "URL to connect to Postgres database.",
     "required": false
    },
    "POSTGRES_USER": {
     "defaultValue": "postgres",
     "description": "User to connect to Postgres DB",
     "required": false
    },
    "SSL_CERT_DAYS": {
     "defaultValue": "820",
     "description": "SSL certificate expiry in days.",
     "required": false
    },
    "POSTGRES_PASSWORD": {
     "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
     "description": "Password to connect to DB",
     "required": false
    },
    "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
     "defaultValue": "60",
     "description": "Allow Postgres to cleanly shut down",
     "required": false
    }
   }
  }
 },
 "buckets": []
}
